# ── Embeddings (always Azure OpenAI — never change after first index) ──────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key
EMBEDDING_MODEL=text-embedding-3-small

# ── Vector Database ────────────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=arxiv-rag

# ── AI Provider — choose one ───────────────────────────────────────────────────
# Option A: Google Gemini (recommended, cost-effective)
CLIENT_TO_BE_USED=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Option B: Azure OpenAI (uncomment and set CLIENT_TO_BE_USED=openai)
# CLIENT_TO_BE_USED=openai
# AZURE_AI_CHAT_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_AI_CHAT_API_KEY=your-azure-chat-key
# AZURE_AI_CHAT_MODEL=gpt-4o-mini
# AZURE_AI_CHAT_API_VERSION=2024-02-15-preview

# ── Application ────────────────────────────────────────────────────────────────
AUTO_INDEX_ON_STARTUP=false
DATA_DIR=/data
FASTAPI_ENV=production

# ── Search ─────────────────────────────────────────────────────────────────────
DEFAULT_SEARCH_RESULTS_K=5
MAX_SEARCH_RESULTS_K=20

# ── Observability (optional) ───────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=arxiv-rag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
